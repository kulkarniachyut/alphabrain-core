# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# Local Terraform data and providers
**/.terraform/*
**/.terraform/providers/*

.env
.env.local
.env.dev
.env.prod

# Python cache
__pycache__/
*.pyc

# Airflow logs
logs/
logs/*

# Ignore DAG compiled files
dags/**/__pycache__/
dags/**/*.pyc

# Git internals or system files
*.DS_Store